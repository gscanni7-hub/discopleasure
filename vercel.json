{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/eventi/:anno/:giorno",
      "destination": "/evento"
    },
    {
      "source": "/news/:articolo",
      "destination": "/articolo"
    }
  ],
  "redirects": [
    {
      "source": "/((?!in-costruzione|entra-lplf2xg945|img/|.*\\.(?:js|css|png|jpg|jpeg|svg|webmanifest|ico)$).*)",
      "missing": [
        {
          "type": "cookie",
          "key": "dp_anteprima",
          "value": "1"
        },
        {
          "type": "query",
          "key": "anteprima",
          "value": "lplf2xg945"
        }
      ],
      "destination": "/in-costruzione",
      "permanent": false
    },
    {
      "source": "/calendario",
      "destination": "/apres-ski",
      "permanent": true
    },
    {
      "source": "/aggiornamenti",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/chalet",
      "destination": "/chi-siamo",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news/come-arrivare",
      "destination": "/come-arrivare",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/entra-lplf2xg945",
      "headers": [
        {
          "key": "Set-Cookie",
          "value": "dp_anteprima=1; Path=/; Max-Age=31536000; SameSite=Lax; Secure"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "anteprima",
          "value": "lplf2xg945"
        }
      ],
      "headers": [
        {
          "key": "Set-Cookie",
          "value": "dp_anteprima=1; Path=/; Max-Age=31536000; SameSite=Lax; Secure"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}