{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/eventi/:anno/:giorno",
      "destination": "/evento"
    },
    {
      "source": "/news/:articolo",
      "destination": "/articolo"
    },
    {
      "source": "/artisti/:artista",
      "destination": "/artista"
    },
    {
      "source": "/en/events/:year/:day",
      "destination": "/en/event"
    },
    {
      "source": "/en/news/:article",
      "destination": "/en/article"
    },
    {
      "source": "/en/artists/:artist",
      "destination": "/en/artist"
    }
  ],
  "redirects": [
    {
      "source": "/calendario",
      "destination": "/apres-ski",
      "permanent": true
    },
    {
      "source": "/aggiornamenti",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/chalet",
      "destination": "/chi-siamo",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/news/come-arrivare",
      "destination": "/come-arrivare",
      "permanent": true
    },
    {
      "source": "/in-costruzione",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/entra-lplf2xg945",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
